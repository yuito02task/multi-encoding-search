{
  "name": "multi-encoding-search",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.3",
  "publisher": "yuitomaruyama",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuito02task/multi-encoding-search.git"
  },
  "bugs": {
    "url": "https://github.com/yuito02task/multi-encoding-search/issues"
  },
  "homepage": "https://github.com/yuito02task/multi-encoding-search#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "encoding",
    "euc-jp",
    "eucjp",
    "shift_jis",
    "shiftjis",
    "sjis",
    "cp932",
    "windows-31j",
    "utf-8",
    "utf8",
    "utf-16",
    "utf16le",
    "windows-1252",
    "latin1",
    "gb18030",
    "gbk",
    "big5",
    "euc-kr",
    "search",
    "workspace-search",
    "search-in-files",
    "mixed-encoding",
    "ripgrep",
    "japanese",
    "mojibake",
    "legacy-code",
    "issue-127896",
    "issue-256502",
    "issue-23570"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multi-encoding-search-container",
          "title": "%viewsContainers.multiEncodingSearch.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multi-encoding-search-container": [
        {
          "type": "webview",
          "id": "multiEncodingSearch.searchView",
          "name": "%views.multiEncodingSearch.name%"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "multiEncodingSearch.encodings": {
          "type": "object",
          "description": "%config.encodings.description%",
          "default": {
            "utf8": true,
            "eucjp": true,
            "shiftjis": true,
            "utf16le": true,
            "utf16be": true,
            "windows1252": true,
            "gb18030": true,
            "gbk": true,
            "big5": true,
            "euckr": true
          },
          "properties": {
            "utf8": {
              "type": "boolean",
              "default": true,
              "description": "UTF-8"
            },
            "eucjp": {
              "type": "boolean",
              "default": true,
              "description": "EUC-JP (Japanese Unix/Linux)"
            },
            "shiftjis": {
              "type": "boolean",
              "default": true,
              "description": "Shift_JIS / CP932 / Windows-31J (Japanese Windows)"
            },
            "utf16le": {
              "type": "boolean",
              "default": true,
              "description": "UTF-16 LE (Little Endian Unicode)"
            },
            "utf16be": {
              "type": "boolean",
              "default": true,
              "description": "UTF-16 BE (Big Endian Unicode)"
            },
            "windows1252": {
              "type": "boolean",
              "default": true,
              "description": "Windows-1252 / Latin-1 (Western European)"
            },
            "gb18030": {
              "type": "boolean",
              "default": true,
              "description": "GB18030 (Simplified Chinese National Standard)"
            },
            "gbk": {
              "type": "boolean",
              "default": true,
              "description": "GBK (Simplified Chinese Legacy)"
            },
            "big5": {
              "type": "boolean",
              "default": true,
              "description": "Big5 (Traditional Chinese)"
            },
            "euckr": {
              "type": "boolean",
              "default": true,
              "description": "EUC-KR (Korean Legacy)"
            }
          }
        },
        "multiEncodingSearch.rgPath": {
          "type": "string",
          "default": "rg",
          "description": "%config.rgPath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}
