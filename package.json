{
  "name": "multi-encoding-search",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.5.2",
  "publisher": "yuitomaruyama",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuito02task/multi-encoding-search.git"
  },
  "bugs": {
    "url": "https://github.com/yuito02task/multi-encoding-search/issues"
  },
  "homepage": "https://github.com/yuito02task/multi-encoding-search#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "encoding",
    "multi-encoding",
    "search",
    "grep",
    "euc-jp",
    "eucjp",
    "shift_jis",
    "shiftjis",
    "sjis",
    "cp932",
    "windows-31j",
    "utf-8",
    "utf-16",
    "windows-1252",
    "gb18030",
    "gbk",
    "big5",
    "euc-kr",
    "workspace-search",
    "search-in-files",
    "mixed-encoding",
    "ripgrep",
    "japanese",
    "mojibake",
    "文字コード",
    "検索",
    "文字化け",
    "日本語検索",
    "issue-127896",
    "issue-23570"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:multiEncodingSearch.searchView"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multi-encoding-search-container",
          "title": "%viewsContainers.multiEncodingSearch.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multi-encoding-search-container": [
        {
          "type": "webview",
          "id": "multiEncodingSearch.searchView",
          "name": "%views.multiEncodingSearch.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "multiEncodingSearch.findInFiles",
        "title": "%command.findInFiles.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%"
      },
      {
        "command": "multiEncodingSearch.refresh",
        "title": "%command.refresh.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(refresh)",
        "enablement": "multiEncodingSearch.hasSearchPattern"
      },
      {
        "command": "multiEncodingSearch.clearSearchResults",
        "title": "%command.clearSearchResults.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(clear-all)",
        "enablement": "multiEncodingSearch.hasSearchResults || multiEncodingSearch.hasSearchPattern"
      },
      {
        "command": "multiEncodingSearch.viewAsTree",
        "title": "%command.viewAsTree.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(list-tree)",
        "enablement": "multiEncodingSearch.hasSearchResults"
      },
      {
        "command": "multiEncodingSearch.viewAsList",
        "title": "%command.viewAsList.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(list-flat)",
        "enablement": "multiEncodingSearch.hasSearchResults"
      },
      {
        "command": "multiEncodingSearch.openNewSearchEditor",
        "title": "%command.openNewSearchEditor.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "multiEncodingSearch.collapseAll",
        "title": "%command.collapseAll.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(collapse-all)",
        "enablement": "multiEncodingSearch.hasSearchResults"
      },
      {
        "command": "multiEncodingSearch.expandAll",
        "title": "%command.expandAll.title%",
        "category": "%viewsContainers.multiEncodingSearch.title%",
        "icon": "$(expand-all)",
        "enablement": "multiEncodingSearch.hasSearchResults"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiEncodingSearch.refresh",
          "when": "view == multiEncodingSearch.searchView",
          "group": "navigation@1"
        },
        {
          "command": "multiEncodingSearch.clearSearchResults",
          "when": "view == multiEncodingSearch.searchView",
          "group": "navigation@2"
        },
        {
          "command": "multiEncodingSearch.viewAsTree",
          "when": "view == multiEncodingSearch.searchView && !multiEncodingSearch.isTreeMode",
          "group": "navigation@3"
        },
        {
          "command": "multiEncodingSearch.viewAsList",
          "when": "view == multiEncodingSearch.searchView && multiEncodingSearch.isTreeMode",
          "group": "navigation@3"
        },
        {
          "command": "multiEncodingSearch.openNewSearchEditor",
          "when": "view == multiEncodingSearch.searchView",
          "group": "navigation@4"
        },
        {
          "command": "multiEncodingSearch.collapseAll",
          "when": "view == multiEncodingSearch.searchView && !multiEncodingSearch.allCollapsed",
          "group": "navigation@5"
        },
        {
          "command": "multiEncodingSearch.expandAll",
          "when": "view == multiEncodingSearch.searchView && multiEncodingSearch.allCollapsed",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.multi-encoding-search-container",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      },
      {
        "command": "multiEncodingSearch.findInFiles",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "multiEncodingSearch.encodings.utf8": {
          "type": "boolean",
          "default": true,
          "description": "UTF-8"
        },
        "multiEncodingSearch.encodings.eucjp": {
          "type": "boolean",
          "default": true,
          "description": "EUC-JP (Japanese Unix/Linux)"
        },
        "multiEncodingSearch.encodings.shiftjis": {
          "type": "boolean",
          "default": true,
          "description": "Shift_JIS / CP932 / Windows-31J (Japanese Windows)"
        },
        "multiEncodingSearch.encodings.utf16le": {
          "type": "boolean",
          "default": true,
          "description": "UTF-16 LE (Little Endian Unicode)"
        },
        "multiEncodingSearch.encodings.utf16be": {
          "type": "boolean",
          "default": true,
          "description": "UTF-16 BE (Big Endian Unicode)"
        },
        "multiEncodingSearch.encodings.windows1252": {
          "type": "boolean",
          "default": true,
          "description": "Windows-1252 / Latin-1 (Western European)"
        },
        "multiEncodingSearch.encodings.gb18030": {
          "type": "boolean",
          "default": true,
          "description": "GB18030 (Simplified Chinese National Standard)"
        },
        "multiEncodingSearch.encodings.gbk": {
          "type": "boolean",
          "default": true,
          "description": "GBK (Simplified Chinese Legacy)"
        },
        "multiEncodingSearch.encodings.big5": {
          "type": "boolean",
          "default": true,
          "description": "Big5 (Traditional Chinese)"
        },
        "multiEncodingSearch.encodings.euckr": {
          "type": "boolean",
          "default": true,
          "description": "EUC-KR (Korean Legacy)"
        },
        "multiEncodingSearch.rgPath": {
          "type": "string",
          "default": "rg",
          "description": "%config.rgPath.description%"
        },
        "multiEncodingSearch.results.showLineNumbers": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.results.showLineNumbers.description%",
          "scope": "window"
        },
        "multiEncodingSearch.results.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "%config.results.fontSize.description%"
        },
        "multiEncodingSearch.results.fontFamily": {
          "type": "string",
          "default": "",
          "description": "%config.results.fontFamily.description%"
        },
        "multiEncodingSearch.results.matchHighlightBackground": {
          "type": "string",
          "default": "",
          "description": "%config.results.matchHighlightBackground.description%"
        },
        "multiEncodingSearch.results.matchHighlightForeground": {
          "type": "string",
          "default": "",
          "description": "%config.results.matchHighlightForeground.description%"
        },
        "multiEncodingSearch.results.textColor": {
          "type": "string",
          "default": "",
          "description": "%config.results.textColor.description%"
        },
        "multiEncodingSearch.results.secondaryTextColor": {
          "type": "string",
          "default": "",
          "description": "%config.results.secondaryTextColor.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}